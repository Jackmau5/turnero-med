{
  "info": {
    "name": "Turnero Med - flujo completo local",
    "description": "Ejecutar en orden con el perfil local. Crea datos ficticios de prueba. Guarda IDs y JWT en variables locales de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "medicoId",
      "value": ""
    },
    {
      "key": "turnoId",
      "value": ""
    },
    {
      "key": "pacienteId",
      "value": ""
    },
    {
      "key": "carritoId",
      "value": ""
    },
    {
      "key": "emailMedico",
      "value": ""
    },
    {
      "key": "matricula",
      "value": ""
    },
    {
      "key": "emailPaciente",
      "value": ""
    },
    {
      "key": "dni",
      "value": ""
    },
    {
      "key": "dia",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Salud del servidor",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Login administrador demo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@turnero.local\",\n  \"password\": \"AdminDemo123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"adminToken\", data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Crear médico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/medicos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Prueba\",\n  \"email\": \"{{emailMedico}}\",\n  \"password\": \"MedicoPrueba123!\",\n  \"matricula\": \"{{matricula}}\",\n  \"especialidad\": \"CARDIOLOGIA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"medicoId\", data.id);",
              "}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = Date.now().toString();",
              "pm.collectionVariables.set(\"emailMedico\", \"medico\" + id + \"@ejemplo.test\");",
              "pm.collectionVariables.set(\"matricula\", \"DEMO-\" + id);",
              "const tomorrow = new Date(); tomorrow.setDate(tomorrow.getDate() + 1);",
              "pm.collectionVariables.set(\"dia\", `${tomorrow.getFullYear()}-${String(tomorrow.getMonth()+1).padStart(2,\"0\")}-${String(tomorrow.getDate()).padStart(2,\"0\")}`);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Publicar horario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/turnos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"medicoId\": {{medicoId}},\n  \"fecha\": {\n    \"dia\": \"{{dia}}\",\n    \"hora\": \"10:00\"\n  },\n  \"direccion\": {\n    \"calle\": \"Ejemplo\",\n    \"altura\": 123,\n    \"ciudad\": \"Buenos Aires\",\n    \"codigoPostal\": \"1000\"\n  },\n  \"precio\": 25000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"turnoId\", data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Registrar paciente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Lucia\",\n  \"apellido\": \"Prueba\",\n  \"email\": \"{{emailPaciente}}\",\n  \"password\": \"PacientePrueba123!\",\n  \"dni\": \"{{dni}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"token\", data.token);",
              "  pm.collectionVariables.set(\"pacienteId\", data.id);",
              "}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = Date.now().toString();",
              "pm.collectionVariables.set(\"emailPaciente\", \"paciente\" + id + \"@ejemplo.test\");",
              "pm.collectionVariables.set(\"dni\", id.slice(-9));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Login paciente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailPaciente}}\",\n  \"password\": \"PacientePrueba123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"token\", data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Consultar disponibilidad",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/turnos?medicoId={{medicoId}}&dia={{dia}}&especialidad=CARDIOLOGIA&estado=DISPONIBLE"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
