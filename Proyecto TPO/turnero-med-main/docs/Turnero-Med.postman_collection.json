    },
    {
      "name": "14 - Comprobar horario liberado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/turnos?medicoId={{medicoId}}&dia={{dia}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
