            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"carritoId\", data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Agregar turno",
